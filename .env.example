# Copy to .env (git-ignored) and adjust for your machine.

# Postgres connection string used by the API.
# Local dev default (docker compose db): postgres://postgres:postgres@localhost:5432/riders
# Production: use your platform's managed Postgres internal connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/riders

# API port (platforms like Render inject PORT automatically)
# PORT=4000

# NODE_ENV=production
